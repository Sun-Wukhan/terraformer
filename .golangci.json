{"formatters": {"enable": ["gofmt", "goimports"], "exclusions": {"generated": "lax", "paths": ["third_party$", "builtin$", "examples$"]}}, "issues": {"max-issues-per-linter": 0, "max-same-issues": 0}, "linters": {"enable": ["gocritic", "revive", "unconvert", "unparam"], "exclusions": {"generated": "lax", "paths": ["third_party$", "builtin$", "examples$"], "presets": ["comments", "common-false-positives", "legacy", "std-error-handling"], "rules": [{"linters": ["revive"], "text": "unused-parameter"}, {"linters": ["revive"], "text": "stutters"}, {"linters": ["staticcheck"], "text": "ST1005"}, {"linters": ["staticcheck"], "text": "ST1019"}, {"linters": ["staticcheck"], "text": "QF[0-9]+"}, {"linters": ["staticcheck"], "text": "SA1019"}, {"linters": ["revive"], "text": "var-naming"}]}}, "run": {"concurrency": 8, "issues-exit-code": 1, "modules-download-mode": "readonly"}, "version": "2"}